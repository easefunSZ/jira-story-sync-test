# Do not commit the copied pks-v1-validation.env file.
# Example only: replace with the confirmed PKS gateway URL. The value supplied
# in chat, 192.168.31.1100:886, is not a valid IPv4 address and is not used here.
PKS_BASE_URL=https://pks-host.example:443
PKS_GATEWAY_PREFIX=
PKS_AUTHORIZATION=
PKS_X_APIGW_API_ID=
PKS_LANGUAGE=en-US
PKS_USER_AGENT=PostmanRuntime/7.43.0
PKS_ACCEPT=application/json
# Optional browser/gateway headers. Use PKS_HEADER_01, PKS_HEADER_02, ...
# when the gateway requires an approved browser-origin request.
# PKS_HEADER_01=origin: https://secure.adviser.qa.oldmutual.co.za
# PKS_HEADER_02=referer: https://secure.adviser.qa.oldmutual.co.za/
PKS_TIMEOUT_SECONDS=20
PKS_CURL_INSECURE=false

# Existing V1/ecommon behavior observed in the Dev probe.
EXPECTED_VALIDATION_DATA=[]\ Validation\ failed
