# Remote Git Bash WebSocket. Keep localhost when the SSH/tunnel mapping is active.
REMOTE_BASH_WS=ws://127.0.0.1:7681/ws

# Remote path to the application-*.properties actually used by the running service.
# This file remains on the remote machine; its database password is never copied here.
REMOTE_DB_PROPERTIES_PATH=D:/code/<running-service>/target/classes/application-dev.properties

# Optional timeout for one remote database checkpoint.
REMOTE_DB_TIMEOUT_MS=30000
